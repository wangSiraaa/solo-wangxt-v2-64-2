# 演示默认使用用户态嵌入式 PostgreSQL（无需系统安装 / root）。
# 如已有外部 PostgreSQL，设置 DB_HOST 即切换为外部连接模式。
DB_HOST=
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=eldercare
EMBEDDED_PG_PORT=55432
EMBEDDED_PG_DATA_DIR=.pg-data
SEED_ON_BOOT=true

# 申诉闭环（均有默认值，演示环境可不配）
APPEAL_WINDOW_DAYS=30
APPEAL_CORRECTION_DAYS=15
APPEAL_IMPACT_HORIZON_DAYS=30
